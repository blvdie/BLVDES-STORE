<Window x:Class="KURSOVAYA_RABOTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KURSOVAYA_RABOTA"
        mc:Ignorable="d"
        Title="Blvdes Store"
        Width="1200" Height="800"
        WindowStyle="None"
        MinWidth="1200" MinHeight="800"
        MaxWidth="1200" MaxHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        MouseDown="Window_MouseDown">

    <Grid>
        <!-- Фоновое изображение -->
        <Image Source="/images/pattern.png"
               Stretch="UniformToFill"
               Margin="0,30,0,-30"/>

        <!-- Панель управления окном -->
        <DockPanel LastChildFill="False" Height="30" Background="#222222" VerticalAlignment="Top">
            <Image Source="/images/logo.png" Width="30" Height="30" Margin="10,0,0,0"/>
            <TextBlock Text="BLVDES STORE" Foreground="#be8dee" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Minimize_Click">
                    <Path Data="M 0,7 L 30,7" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Maximize_Click">
                    <Path Data="M 0,0 L 0,30 M 30,0 L 30,30 M 0,0 L 30,0 M 0,30 L 30,30" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Close_Click">
                    <Path Data="M 0,0 L 30,30 M 0,30 L 30,0" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Frame для навигации между страницами -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>