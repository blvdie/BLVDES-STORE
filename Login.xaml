<Page x:Class="KURSOVAYA_RABOTA.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KURSOVAYA_RABOTA"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Login">
    <Grid>
        <Border BorderBrush="#be8dee" BorderThickness="2" CornerRadius="10" Padding="40" Background="#121212"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">

            <StackPanel>
                <TextBlock Text="Вход" FontSize="32" Foreground="#be8dee" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Имя пользователя" Margin="0,20,0,5"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,10"/>
                <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                <!-- PasswordBox + TextBox -->
                <Grid>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" 
                                 Visibility="Visible"
                                 x:FieldModifier="public"/>
                    <TextBox x:Name="PasswordTextBox" 
                             Margin="0,0,0,10"
                             Visibility="Collapsed"
                             Text="{Binding Path=Password, ElementName=PasswordBox}"
                             PreviewMouseDown="PasswordTextBox_PreviewMouseDown"/>
                </Grid>
                <CheckBox x:Name="ShowPasswordCheck" Content="Показать пароль" Margin="0,0,0,20"
                          Checked="ShowPassword_Checked" Unchecked="ShowPassword_Checked"/>
                <!-- Кнопка с жирным текстом -->
                <Button Content="Войти" Width="150" Height="40" Background="#be8dee" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="Login_Click"
                        FontWeight="Bold"/>
                <!-- Жирный шрифт -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Нет аккаунта? " Foreground="Gray"/>
                    <TextBlock Text="Зарегистрироваться" Cursor="Hand" Foreground="#be8dee" TextDecorations="Underline"
                               MouseDown="GoToRegister"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Уведомление -->
        <Border x:Name="NotificationBorder" 
Visibility="Collapsed"
Background="#121212" 
BorderBrush="#FFD32F2F" 
BorderThickness="1" 
CornerRadius="4" 
Padding="8"
HorizontalAlignment="Center" 
VerticalAlignment="Top" 
Margin="850,-85,0,0"
Width="300"
Height="60">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationSlide"/>
            </Border.RenderTransform>
            <Grid>
                <TextBlock x:Name="NotificationIcon" 
           Text="⚠" 
           Foreground="#FFD32F2F" 
           FontSize="20" 
           FontWeight="Bold" 
           VerticalAlignment="Center" 
           HorizontalAlignment="Left" 
           Margin="5,0,0,0"/>

                <!-- Текст уведомления -->
                <TextBlock x:Name="NotificationText" 
           TextWrapping="Wrap" 
           Foreground="#FFD32F2F" 
           TextAlignment="Center" 
           VerticalAlignment="Center"
           Margin="25,0,30,0"/>

                <!-- Кнопка закрытия -->
                <Button x:Name="CloseNotificationBtn"
        Content="✖"
        FontSize="14"
        FontWeight="Bold"
        Foreground="#FFD32F2F"
        Background="Transparent"
        BorderBrush="Transparent"
        Width="20" Height="20"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="CloseNotificationBtn_Click"
        Margin="0,0,0,0"
        Focusable="False">
                    <!-- Убираем выделение -->
                    <Button.Template>
                        <ControlTemplate>
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
