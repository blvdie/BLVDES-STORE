<Window x:Class="KURSOVAYA_RABOTA.Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KURSOVAYA_RABOTA"
        mc:Ignorable="d"
        Title="Добавить скин" Height="500" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        WindowStyle="None" 
                MaxWidth="400"   
    MaxHeight="500">
    <Grid Margin="10,10,10,10">
        <DockPanel LastChildFill="False" Height="30" Background="#222222" VerticalAlignment="Top" Margin="-10,-10,-10,0">
            <Image Source="/images/logo.png" Width="30" Height="30" Margin="10,0,0,0"/>
            <TextBlock Text="BLVDES STORE" Foreground="#be8dee" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>

            <!-- Кнопки управления справа -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,10,0">
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Minimize_Click">
                    <Path Data="M 0,7 L 30,7" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Maximize_Click">
                    <Path Data="M 0,0 L 0,30 M 30,0 L 30,30 M 0,0 L 30,0 M 0,30 L 30,30" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
                <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="Close_Click">
                    <Path Data="M 0,0 L 30,30 M 0,30 L 30,0" Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </DockPanel>
        <StackPanel Margin="0,30,0,0">
            <!-- Название -->
            <TextBox x:Name="NameBox" 
                     Text="Название скина" 
                     Foreground="#888"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     Margin="0,0,0,10"/>

            <!-- Цена -->
            <TextBox x:Name="PriceBox" 
                     Text="Цена" 
                     Foreground="#888"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     PreviewTextInput="PriceBox_PreviewTextInput"
                     Margin="0,0,0,10"/>

            <!-- Изображение -->
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IconUrlBox" 
                         Text="URL изображения" 
                         Foreground="#888"
                         GotFocus="TextBox_GotFocus"
                         LostFocus="TextBox_LostFocus"/>
                <Button Content="Выбрать файл" Click="ChooseFile_Click" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Герой -->
            <ComboBox x:Name="HeroCombo" DisplayMemberPath="HeroName" SelectedValuePath="HeroId" Margin="0,10,0,0"/>

            <!-- Слот -->
            <ComboBox x:Name="SlotCombo" DisplayMemberPath="SlotName" SelectedValuePath="SlotId" Margin="0,10,0,0"/>

            <!-- Редкость -->
            <ComboBox x:Name="RarityCombo" DisplayMemberPath="RarityName" SelectedValuePath="RarityId" Margin="0,10,0,0"/>

            <!-- Холд -->
            <ComboBox x:Name="HoldCombo" DisplayMemberPath="Description" SelectedValuePath="HoldPeriodId" Margin="0,10,0,0"/>

            <!-- Сохранить -->
            <Button Content="Сохранить" 
                    Click="Save_Click" 
                    Background="#be8dee" 
                    Foreground="White" 
                    Padding="10" Height="41" Width="370"
                     Margin="0,60,0,0"/>

            <!-- Отмена -->
            <Button Content="Отмена" 
                    Click="Cancel_Click" 
                    Background="#888888" 
                    Foreground="White" 
                    Padding="10" Height="40" Width="370"
                      Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
