<Page x:Class="KURSOVAYA_RABOTA.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KURSOVAYA_RABOTA"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Register">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="#be8dee" BorderThickness="2" CornerRadius="10" Padding="40" Background="#121212"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Width="450">
                <StackPanel Height="624">
                    <TextBlock Text="Регистрация" FontSize="32" Foreground="#be8dee" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Имя пользователя" Margin="0,20,0,5"/>
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Никнейм" Margin="0,0,0,5"/>
                    <TextBox x:Name="NicknameBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Email" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Подтвердите пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Выбрать аватар" Width="150" Height="30" Background="#be8dee" Foreground="White"
                                Click="SelectAvatar_Click"/>
                        <TextBlock x:Name="AvatarPathText" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button Content="Зарегистрироваться" Width="170" Height="40" Background="#be8dee" Foreground="White" Margin="0,25,0,0"
                            HorizontalAlignment="Center" Click="Register_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Есть аккаунт? " Foreground="Gray"/>
                        <TextBlock Text="Войти" Cursor="Hand" Foreground="#be8dee" TextDecorations="Underline" MouseDown="GoToLogin"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border x:Name="NotificationBorder" 
Visibility="Collapsed"
Background="#121212" 
BorderBrush="#FFD32F2F" 
BorderThickness="1" 
CornerRadius="4" 
Padding="8"
HorizontalAlignment="Center" 
VerticalAlignment="Top" 
Margin="850,70,0,0"
Width="300"
Height="60">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationSlide"/>
            </Border.RenderTransform>
            <Grid>
                <TextBlock x:Name="NotificationIcon" 
           Text="⚠" 
           Foreground="#FFD32F2F" 
           FontSize="20" 
           FontWeight="Bold" 
           VerticalAlignment="Center" 
           HorizontalAlignment="Left" 
           Margin="5,0,0,0"/>

                <!-- Текст уведомления -->
                <TextBlock x:Name="NotificationText" 
           TextWrapping="Wrap" 
           Foreground="#FFD32F2F" 
           TextAlignment="Center" 
           VerticalAlignment="Center"
           Margin="25,0,30,0"/>

                <!-- Кнопка закрытия -->
                <Button x:Name="CloseNotificationBtn"
        Content="✖"
        FontSize="14"
        FontWeight="Bold"
        Foreground="#FFD32F2F"
        Background="Transparent"
        BorderBrush="Transparent"
        Width="20" Height="20"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="CloseNotificationBtn_Click"
        Margin="0,0,5,0"
        Focusable="False">
                    <!-- Убираем выделение -->
                    <Button.Template>
                        <ControlTemplate>
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Border>
    </Grid>
</Page>